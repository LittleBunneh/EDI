# Enhanced Cosmic EVI Deployment Configuration
# Primary Domain Configuration
REACT_APP_PRIMARY_DOMAIN=https://www.prometheanconduit.ai
REACT_APP_SECONDARY_DOMAIN=https://prometheanconduit.ai

# PythonAnywhere API Configuration
REACT_APP_API_URL=https://LittleBunnehGod.pythonanywhere.com/api
REACT_APP_WS_URL=wss://LittleBunnehGod.pythonanywhere.com/ws

# Cosmic Consciousness Configuration
REACT_APP_COSMIC_MODE=true
REACT_APP_CONSCIOUSNESS_LEVEL=advanced
REACT_APP_UNIVERSAL_ALIGNMENT=true

# EVI System Configuration
